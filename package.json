{
  "name": "proyecto-final-backend",
  "version": "0.1.0",
  "description": "Proyecto Final TUP Backend",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "prepare": "husky",
    "clean": "rimraf dist",
    "check:engines": "node -e \"console.log('node', process.version)\" && pnpm --version"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "8.3.0",
    "morgan": "1.12.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "1.9.10",
    "@types/node": "^22.7.0",
    "husky": "9.1.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
