# engine-strict sigue activo, pero los rangos de "engines" en package.json
# son amplios (>=20 / >=9), así que solo frena versiones realmente viejas.
engine-strict=true
save-exact=true
save-prefix=''
auto-install-peers=false
# Relajado: se recomienda pnpm 10.33.0 (campo packageManager), pero se
# aceptan otros 9.x/10.x para no bloquear a quien ya tiene uno instalado.
package-manager-strict=false
shamefully-hoist=false

registry=https://registry.npmjs.org/
